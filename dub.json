{
    "name": "d-xatlas",
    "description": "D bindings for jpcy/xatlas — UV atlas unwrapping and chart packing via a C shim.",
    "license": "MIT",
    "authors": ["Alexander Shagarov"],

    "sourcePaths": ["source"],
    "importPaths": ["source"],

    "preBuildCommands-posix": [
        "cd \"$PACKAGE_DIR\" && git submodule update --init --recursive --quiet",
        "cmake -S \"$PACKAGE_DIR\" -B \"$PACKAGE_DIR/build\" -DCMAKE_BUILD_TYPE=Release",
        "cmake --build \"$PACKAGE_DIR/build\" -j --target xatlas_c"
    ],
    "lflags-posix": ["-L$PACKAGE_DIR/build"],
    "libs-linux": ["xatlas_c", "stdc++", "m"],
    "libs-osx": ["xatlas_c", "c++", "m"],

    "preBuildCommands-windows": [
        "git -C \"$PACKAGE_DIR\" submodule update --init --recursive",
        "cmake -S \"$PACKAGE_DIR\" -B \"$PACKAGE_DIR/build\"",
        "cmake --build \"$PACKAGE_DIR/build\" --config Release --target xatlas_c"
    ],
    "lflags-windows": ["$PACKAGE_DIR/build/Release/xatlas_c.lib"],
    "dflags-windows": ["-mscrtlib=msvcrt"],

    "configurations": [
        {
            "name": "library",
            "targetType": "staticLibrary"
        },
        {
            "name": "unwrap",
            "targetType": "executable",
            "targetName": "unwrap",
            "mainSourceFile": "examples/unwrap.d"
        }
    ]
}
